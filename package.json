{
  "name": "wave",
  "version": "1.1.7",
  "description": "WAVE (Work And Vital Energy) - Minimalist Windows productivity utility that enforces breaks by locking the OS",
  "main": "out/main/index.js",
  "homepage": "./",
  "productionDependencies": true,
  "author": "Manolis Ntamadakis <https://ntamadakis.gr/>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "preview": "electron-vite preview",
    "build:unpacked": "pnpm run build && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "release:pack": "vpk pack --packId com.ntamadakis.wave --packTitle WAVE --packVersion $npm_package_version --packDir dist/win-unpacked --mainExe WAVE.exe --icon dist/.icon-ico/icon.ico",
    "release:publish": "vpk upload github --repoUrl https://github.com/ntamasM/WAVE --publish",
    "release": "pnpm run build:unpacked && pnpm run release:pack && pnpm run release:publish"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.20.0",
    "react-toastify": "^11.0.5",
    "velopack": "0.0.1298"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^39.0.0",
    "electron-builder": "^24.6.4",
    "electron-vite": "^2.0.0",
    "eslint": "^8.55.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  }
}
